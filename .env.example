# Copie para .env.local e preencha com as chaves do SEU projeto Supabase
# (Supabase → Project Settings → API Keys). Nunca versione o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Use a "Publishable key" (sb_publishable_...) — ou a antiga chave "anon",
# se o seu projeto ainda usar o formato legado. Ela é segura no navegador:
# quem decide o que cada pessoa enxerga é o RLS do Postgres.
# NUNCA use aqui a "Secret key" (sb_secret_...) nem a service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cole-a-sua-chave-aqui

# Opcional: fuso usado para digitar e exibir data/hora dos eventos.
# NEXT_PUBLIC_FUSO_IGREJA=America/Sao_Paulo
